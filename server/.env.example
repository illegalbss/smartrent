DATABASE_URL="postgresql://user:password@host:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://user:password@host:5432/postgres"

PORT=4000
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
# Auth endpoint rate limit per 15-minute window per IP. Keep low (~20) in production;
# raise for local development to avoid tripping the limiter during manual testing.
AUTH_RATE_LIMIT=20

# Paystack test-mode keys from https://dashboard.paystack.com/#/settings/developer
PAYSTACK_SECRET_KEY=sk_test_replace_me
PAYSTACK_PUBLIC_KEY=pk_test_replace_me

# Supabase Storage — Project Settings > API > service_role key. Used for all
# document/photo uploads (durable, survives redeploys, unlike local disk).
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
SUPABASE_STORAGE_BUCKET=smartrent-uploads

# Password reset emails. Preferred: Brevo SMTP (brevo.com > Settings > SMTP & API).
# MAIL_FROM must be a sender address verified in Brevo.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your-login@smtp-brevo.com
SMTP_PASS=your-brevo-smtp-key
MAIL_FROM=yourname@gmail.com
# Alternative to SMTP_*: Gmail with a Google App Password (NOT your normal
# Gmail password — Google rejects those).
# GMAIL_USER=yourname@gmail.com
# GMAIL_APP_PASSWORD=abcd efgh ijkl mnop
# Where the frontend lives — reset links in emails point here.
CLIENT_URL=http://localhost:3000
